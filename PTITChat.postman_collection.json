{
  "info": {
    "name": "PTITChat API Collection",
    "description": "Bộ API hoàn chỉnh cho đồ án PTITChat - Quản lý hội thoại, tin nhắn, reply, thu hồi, upload và phân quyền",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "conversationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Xác thực (Auth)",
      "item": [
        {
          "name": "Đăng nhập (Lấy Token tự động)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Đã tự động lưu token:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ngotung05\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập bằng tài khoản Ngô Bùi Tùng. Script sẽ tự động lấy token lưu vào biến {{token}}."
          }
        },
        {
          "name": "Xem thông tin cá nhân (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Quản lý Hội Thoại (Conversations)",
      "item": [
        {
          "name": "Lấy danh sách cuộc trò chuyện",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.length > 0) {",
                  "    pm.collectionVariables.set('conversationId', res.data[0]._id);",
                  "    console.log('Đã lưu conversationId mẫu:', res.data[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            },
            "description": "Lấy toàn bộ hội thoại 1-1 và nhóm của user hiện tại, sắp xếp theo tin mới nhất."
          }
        },
        {
          "name": "Tạo hoặc lấy hội thoại 1-1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientId\": \"ID_CUA_NGUYEN_MANH_TIEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations"]
            },
            "description": "Tạo hội thoại 1-1. Nếu đã có sẵn thì trả về cái cũ (chống tạo trùng)."
          }
        },
        {
          "name": "Tạo nhóm trò chuyện mới",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nhóm Học Tập PTIT\",\n  \"members\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/group",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "group"]
            }
          }
        },
        {
          "name": "Cập nhật nhóm (Đổi tên, thêm/xóa thành viên)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nhóm Đồ Án PTITChat Pro 2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "conversations", "{{conversationId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Quản lý Tin Nhắn (Messages)",
      "item": [
        {
          "name": "Lấy lịch sử tin nhắn theo hội thoại (Phân trang)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{conversationId}}?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "{{conversationId}}"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Gửi tin nhắn văn bản mới",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('messageId', res.data._id);",
                  "    console.log('Đã lưu messageId vừa gửi:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"text\": \"Xin chào, đây là tin nhắn test từ Postman!\",\n  \"clientTempId\": \"client-temp-test-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "Trả lời tin nhắn (replyTo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"text\": \"Mình phản hồi lại tin nhắn trước đó nhé!\",\n  \"replyTo\": \"{{messageId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages"]
            }
          }
        },
        {
          "name": "Chỉnh sửa tin nhắn của chính mình",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Nội dung tin nhắn này đã được sửa thành công!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "{{messageId}}"]
            }
          }
        },
        {
          "name": "Thu hồi mềm tin nhắn (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "{{messageId}}"]
            },
            "description": "Thu hồi mềm: Đánh dấu isRecall=true, ẩn nội dung thành 'Tin nhắn đã bị thu hồi', bản ghi trong DB vẫn giữ nguyên."
          }
        },
        {
          "name": "Tìm kiếm tin nhắn theo từ khóa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/messages/search?q=test&conversationId={{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "messages", "search"],
              "query": [
                {
                  "key": "q",
                  "value": "test"
                },
                {
                  "key": "conversationId",
                  "value": "{{conversationId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Tải lên tệp (Uploads)",
      "item": [
        {
          "name": "Upload ảnh hoặc tệp (Multer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/uploads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"]
            },
            "description": "Chọn 1 tệp ảnh (.png, .jpg, ...) hoặc tài liệu (.pdf, .docx, .zip, ...) dung lượng < 25MB."
          }
        }
      ]
    }
  ]
}
